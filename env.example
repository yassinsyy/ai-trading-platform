# Database
DATABASE_URL="postgresql://username:password@localhost:5432/ai_trading_db"

# JWT
JWT_SECRET="your-super-secret-jwt-key-here"
JWT_EXPIRES_IN="15m"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# External Services
ML_SERVICE_URL="http://localhost:8000"
CONTENT_SERVICE_URL="http://localhost:8001"

# Marketplace API Keys (примеры)
KASPI_API_KEY=""
KASPI_API_SECRET=""
WILDBERRIES_API_KEY=""
OZON_API_KEY=""
OZON_API_SECRET=""
AMAZON_ACCESS_KEY=""
AMAZON_SECRET_KEY=""

# OpenAI/Anthropic
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Monitoring
SENTRY_DSN=""
PROMETHEUS_PORT=9090

# App
PORT=3001
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"

# PriceFeed Configuration
PRICEFEED_PUBLIC_BASE_URL="https://cdn.example.com/feeds"
PRICEFEED_BUCKET="pricefeeds"
PRICEFEED_PREFIX="kaspi/"
PRICEFEED_PUBLISH_INTERVAL_CRON="*/15 * * * *"

# Marketplace Adapter Configuration
MP_KASPI_MODE=feed      # feed|api|sim
KASPI_BATCH_SIZE=100
KASPI_API_BASE_URL="https://kaspi.kz/shop/api/v2"
KASPI_API_TOKEN=""

# Simulation Configuration
SIM_BASE_URL="http://localhost:3001"

# S3/MinIO Storage
S3_ENDPOINT="https://s3.example.com"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="your-access-key"
S3_SECRET_ACCESS_KEY="your-secret-key"
S3_FORCE_PATH_STYLE="false"
